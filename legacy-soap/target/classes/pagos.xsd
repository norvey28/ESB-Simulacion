<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://legacy.com/soap"
           xmlns:tns="http://legacy.com/soap"
           elementFormDefault="qualified">

    <xs:element name="procesarPagoRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="cliente" type="xs:string"/>
                <xs:element name="monto" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="procesarPagoResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="status" type="xs:string"/>
                <xs:element name="codigo" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
